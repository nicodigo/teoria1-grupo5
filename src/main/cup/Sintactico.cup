// ============================================================================
// Sintactico.cup — especificación sintáctica del TP Compilador (Grupo 5)
//
// Procesada por cup-maven-plugin 11b-20160615-3 en la fase generate-sources. Genera en
// target/generated-sources/cup/unlu/teoi/grupo5/parser/:
//   Parser.java  (analizador sintáctico LALR)
//   sym.java     (interfaz con las constantes de token)
// El paquete se configura en pom.xml (<packageName>unlu.teoi.grupo5.parser).
//
// El código generado NO se versiona ni se edita: se edita este .cup y se
// recompila (./mvnw verify).
//
// TODO: reemplazar este esqueleto por la gramática de la entrega 2
// (DECLARE.SECTION / PROGRAM.SECTION, asignaciones, IF/WHILE, salida,
// SUMAIMPAR, etc.). Al escribir la gramática, mantener los terminales en
// sincronía con los tokens que devuelva Lexico.flex.
// ============================================================================

import java_cup.runtime.*;

/* Palabras reservadas */
terminal String DECLARE_SECTION, ENDDECLARE_SECTION, PROGRAM_SECTION, ENDPROGRAM_SECTION;
terminal String FLOAT, INT, STRING;
terminal String WHILE, IF, ELSE, WRITE;
terminal String SUMAIMPAR;

/* Operadores Lógicos y Relacionales */
terminal String AND, OR;
terminal String MENOR, MAYOR, MAYORIGUAL, MENORIGUAL, DISTINTO;

/* Operadores Matemáticos y Asignación */
terminal String ASIGNACION, SUMA, RESTA, DIVISION, MULTIPLICACION;

/* Símbolos */
terminal String PARA, PARC, LLAVEA, LLAVEC, CORCHETEA, CORCHETEC;
terminal String PUNTOYCOMA, COMA;

/* Variables y Constantes */
terminal String ID, CTE_STRING, CTE_E, CTE_F;

/* No terminal inicial (placeholder para que compile) */
non terminal Object programa;

/* Producción vacía: no evaluamos sintaxis en la Entrega 1 */
programa ::= ;
