import java_cup.runtime.*;

/* Terminales mínimos del esqueleto para que el pipeline compile. */
terminal String OTRO;

/* No terminal inicial (placeholder). */
non terminal Object programa;

/* Producción placeholder: un programa es exactamente un token OTRO. */
programa ::= OTRO ;
