<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>unlu.teoi.grupo5</groupId>
  <artifactId>teoi-grupo5</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>teoi-grupo5</name>
  <description>TP Compilador (Teoría de la Computación I - UNLu, Grupo 5): IDE Swing con analizador léxico generado por JFlex.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>

    <!-- Versiones fijadas: ver docs/decisiones-tecnicas.md -->
    <jflex.version>1.9.1</jflex.version>
    <junit.version>5.11.3</junit.version>
    <compiler-plugin.version>3.13.0</compiler-plugin.version>
    <surefire.version>3.5.2</surefire.version>
    <shade.version>3.5.0</shade.version>
    <build-helper.version>3.6.0</build-helper.version>
  </properties>

  <dependencies>
    <!-- Única dependencia: JUnit 5. Swing viene con el JDK y el lexer generado no necesita runtime extra. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 1) Genera Lexico.java desde src/main/jflex/Lexico.flex (fase generate-sources) -->
      <plugin>
        <groupId>de.jflex</groupId>
        <artifactId>jflex-maven-plugin</artifactId>
        <version>${jflex.version}</version>
        <configuration>
          <outputDirectory>${project.build.directory}/generated-sources/jflex</outputDirectory>
          <encodingName>UTF-8</encodingName>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- 2) Agrega target/generated-sources/jflex como raíz de fuentes -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>${build-helper.version}</version>
        <executions>
          <execution>
            <id>add-jflex-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.build.directory}/generated-sources/jflex</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- 3) Compila con JDK 17 (release fija el API level aunque se compile con un JDK más nuevo) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler-plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>

      <!-- 4) Ejecuta los tests JUnit 5 (fase test) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
      </plugin>

      <!-- 5) Empaqueta un JAR único ejecutable (java -jar) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${shade.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>unlu.teoi.grupo5.main.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
